[global]
frame_color = "#1a1a1a"
separator_color = "#1a1a1a"

[base16_low]
    msg_urgency = "low"
    background = "#eaeaea"
    foreground = "#4d4d4d"

[base16_normal]
    msg_urgency = "normal"
    background = "#dfdfdf"
    foreground = "#1a1a1a"

[base16_critical]
    msg_urgency = "critical"
    background = "#990026"
    foreground = "#121212"
