[global]
frame_color = "#abb2bf"
separator_color = "#abb2bf"

[base16_low]
    msg_urgency = "low"
    background = "#474c59"
    foreground = "#6c727f"

[base16_normal]
    msg_urgency = "normal"
    background = "#4c515e"
    foreground = "#abb2bf"

[base16_critical]
    msg_urgency = "critical"
    background = "#e05561"
    foreground = "#bcc1cc"
