[global]
frame_color = "#cccccc"
separator_color = "#cccccc"

[base16_low]
    msg_urgency = "low"
    background = "#0e0e0e"
    foreground = "#333333"

[base16_normal]
    msg_urgency = "normal"
    background = "#181818"
    foreground = "#cccccc"

[base16_critical]
    msg_urgency = "critical"
    background = "#999999"
    foreground = "#d6d6d6"
