[global]
frame_color = "#dce6f2"
separator_color = "#dce6f2"

[base16_low]
    msg_urgency = "low"
    background = "#131c29"
    foreground = "#8fa0b5"

[base16_normal]
    msg_urgency = "normal"
    background = "#173a5a"
    foreground = "#dce6f2"

[base16_critical]
    msg_urgency = "critical"
    background = "#ff8a9a"
    foreground = "#f1f6fc"
