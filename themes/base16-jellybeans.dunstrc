[global]
frame_color = "#d5d5d5"
separator_color = "#d5d5d5"

[base16_low]
    msg_urgency = "low"
    background = "#929292"
    foreground = "#c5c5c5"

[base16_normal]
    msg_urgency = "normal"
    background = "#bdbdbd"
    foreground = "#d5d5d5"

[base16_critical]
    msg_urgency = "critical"
    background = "#ffa1a1"
    foreground = "#dedede"
