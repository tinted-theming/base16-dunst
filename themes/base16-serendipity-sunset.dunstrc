[global]
frame_color = "#dee0ef"
separator_color = "#dee0ef"

[base16_low]
    msg_urgency = "low"
    background = "#272938"
    foreground = "#8d8f9e"

[base16_normal]
    msg_urgency = "normal"
    background = "#272938"
    foreground = "#dee0ef"

[base16_critical]
    msg_urgency = "critical"
    background = "#d1918f"
    foreground = "#dee0ef"
