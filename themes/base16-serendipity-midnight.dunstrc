[global]
frame_color = "#dee0ef"
separator_color = "#dee0ef"

[base16_low]
    msg_urgency = "low"
    background = "#1c1e2d"
    foreground = "#6b6d7c"

[base16_normal]
    msg_urgency = "normal"
    background = "#1c1e2d"
    foreground = "#dee0ef"

[base16_critical]
    msg_urgency = "critical"
    background = "#ee8679"
    foreground = "#dee0ef"
