[global]
frame_color = "#e0e5da"
separator_color = "#e0e5da"

[base16_low]
    msg_urgency = "low"
    background = "#1c1e1a"
    foreground = "#899282"

[base16_normal]
    msg_urgency = "normal"
    background = "#3e5123"
    foreground = "#e0e5da"

[base16_critical]
    msg_urgency = "critical"
    background = "#e28b82"
    foreground = "#ecefe7"
