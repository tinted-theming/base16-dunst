[global]
frame_color = "#f7f1ff"
separator_color = "#f7f1ff"

[base16_low]
    msg_urgency = "low"
    background = "#2b2b2d"
    foreground = "#78757c"

[base16_normal]
    msg_urgency = "normal"
    background = "#363638"
    foreground = "#f7f1ff"

[base16_critical]
    msg_urgency = "critical"
    background = "#fc618d"
    foreground = "#f9f4ff"
