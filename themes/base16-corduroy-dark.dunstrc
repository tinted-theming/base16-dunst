[global]
frame_color = "#ddd8df"
separator_color = "#ddd8df"

[base16_low]
    msg_urgency = "low"
    background = "#1b151e"
    foreground = "#7d7082"

[base16_normal]
    msg_urgency = "normal"
    background = "#221a26"
    foreground = "#ddd8df"

[base16_critical]
    msg_urgency = "critical"
    background = "#e8758a"
    foreground = "#ddd8df"
