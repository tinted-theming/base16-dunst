[global]
frame_color = "#f7f1ff"
separator_color = "#f7f1ff"

[base16_low]
    msg_urgency = "low"
    background = "#161616"
    foreground = "#6b686e"

[base16_normal]
    msg_urgency = "normal"
    background = "#222123"
    foreground = "#f7f1ff"

[base16_critical]
    msg_urgency = "critical"
    background = "#fc618d"
    foreground = "#f9f4ff"
