[global]
frame_color = "#f2dfc0"
separator_color = "#f2dfc0"

[base16_low]
    msg_urgency = "low"
    background = "#2c1a13"
    foreground = "#a98568"

[base16_normal]
    msg_urgency = "normal"
    background = "#3b241a"
    foreground = "#f2dfc0"

[base16_critical]
    msg_urgency = "critical"
    background = "#e07a8a"
    foreground = "#f8ebd3"
