[global]
frame_color = "#d1d7e0"
separator_color = "#d1d7e0"

[base16_low]
    msg_urgency = "low"
    background = "#151b23"
    foreground = "#656c76"

[base16_normal]
    msg_urgency = "normal"
    background = "#2f3742"
    foreground = "#d1d7e0"

[base16_critical]
    msg_urgency = "critical"
    background = "#f0883e"
    foreground = "#f0f6fc"
