[global]
frame_color = "#f7f1ff"
separator_color = "#f7f1ff"

[base16_low]
    msg_urgency = "low"
    background = "#2f1b1b"
    foreground = "#525053"

[base16_normal]
    msg_urgency = "normal"
    background = "#3a2727"
    foreground = "#f7f1ff"

[base16_critical]
    msg_urgency = "critical"
    background = "#fc618d"
    foreground = "#f9f4ff"
