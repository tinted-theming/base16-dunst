[global]
frame_color = "#e0e2ea"
separator_color = "#e0e2ea"

[base16_low]
    msg_urgency = "low"
    background = "#07080d"
    foreground = "#9b9ea4"

[base16_normal]
    msg_urgency = "normal"
    background = "#4f5258"
    foreground = "#e0e2ea"

[base16_critical]
    msg_urgency = "critical"
    background = "#ffc0b9"
    foreground = "#eef1f8"
