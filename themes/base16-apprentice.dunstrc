[global]
frame_color = "#bcbcbc"
separator_color = "#bcbcbc"

[base16_low]
    msg_urgency = "low"
    background = "#303030"
    foreground = "#444444"

[base16_normal]
    msg_urgency = "normal"
    background = "#3a3a3a"
    foreground = "#bcbcbc"

[base16_critical]
    msg_urgency = "critical"
    background = "#af5f5f"
    foreground = "#dfdfdf"
