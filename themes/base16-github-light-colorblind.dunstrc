[global]
frame_color = "#454c54"
separator_color = "#454c54"

[base16_low]
    msg_urgency = "low"
    background = "#f6f8fa"
    foreground = "#818b98"

[base16_normal]
    msg_urgency = "normal"
    background = "#d1d9e0"
    foreground = "#454c54"

[base16_critical]
    msg_urgency = "critical"
    background = "#bc4c00"
    foreground = "#25292e"
